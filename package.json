{
  "name": "myvdkmap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --import ./scripts/sites-env.mjs ./node_modules/vite/bin/vite.js",
    "build": "node --import ./scripts/sites-env.mjs ./node_modules/vinext/dist/cli.js build && node scripts/check-worker.mjs",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "preview": "next build && next start",
    "lint": "eslint",
    "setup": "prisma db push && node scripts/fetch-geo.mjs && prisma db seed",
    "seed": "prisma db seed",
    "seed:works": "tsx prisma/seed.ts --works",
    "fetch-geo": "node scripts/fetch-geo.mjs",
    "fetch-buildings": "node scripts/fetch-buildings.mjs",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/*.test.ts lib/ai/*.test.ts components/map/shapes.test.ts",
    "test:e2e": "playwright test",
    "dev:node": "next dev",
    "build:node": "next build",
    "db:local": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js d1 execute DB --local --persist-to .wrangler/state --file drizzle/0000_initial.sql"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@2gis/mapgl": "^1.81.0",
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@turf/turf": "^7.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.13.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.72.0",
    "next": "~15.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@cloudflare/workers-types": "^4.20260515.1",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-rsc": "^0.5.26",
    "eslint": "^9.39.5",
    "eslint-config-next": "~15.5",
    "prisma": "^6.19.3",
    "react-server-dom-webpack": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vinext": "^1.0.0-beta.5",
    "vite": "^8.0.13",
    "wrangler": "^4.92.0"
  },
  "type": "module"
}
